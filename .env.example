# Template for .env — copy to .env and fill in. Never commit .env.

# ---------- Devin v3 ----------
# Service user token from app.devin.ai (Settings → Service Users). Format: cog_*
DEVIN_API_KEY=cog_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Organization ID, visible in the URL of your Devin dashboard. Format: org-*
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxx
# normal | fast — "fast" trades cost for latency
DEVIN_MODE=normal
# Per-session ACU ceiling. ~30 is a comfortable cap for a CVE remediation.
DEVIN_MAX_ACU_PER_SESSION=30

# ---------- GitHub ----------
# PAT with repo + workflow scopes. `gh auth token` works if you've authed locally.
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Shared secret used to sign webhook payloads. 32+ bytes of random.
GH_WEBHOOK_SECRET=replace_with_secrets.token_urlsafe(32)
FORK_URL=https://github.com/<your-user>/superset
FORK_REPO=<your-user>/superset

# ---------- Safety rails ----------
MAX_CONCURRENT_SESSIONS=3
MAX_SESSIONS_PER_DAY=25
SESSION_TIMEOUT_SECONDS=2700
MAX_FIX_ATTEMPTS=3
POLL_INTERVAL_SECONDS=30

# ---------- Persistence ----------
DB_PATH=./data/automation.db
